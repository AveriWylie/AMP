AMP_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-api-key-here
# Optional; defaults to AMP's Anthropic model.
# ANTHROPIC_MODEL=claude-opus-4-6

# OpenAI-compatible alternative (OpenAI, Ollama, LM Studio, vLLM, and similar servers).
# AMP_MODEL_PROVIDER=openai-compatible
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=your-model-name
# OPENAI_API_KEY=optional-for-local-servers

# Required only for Microsoft device authorization. Register a public-client app;
# AMP never accepts or stores the account password and keeps tokens in memory.
# AMP_MICROSOFT_CLIENT_ID=your-public-client-application-id

# Optional inputs for tools/run_local_world.py.
# These do not belong in .env; set them in your shell or operating-system environment.
# AMP_WORLD_PATH=C:\Users\you\AppData\Roaming\.minecraft\saves\My World
# AMP_MC_VERSION=26.2
# AMP_SERVER_PORT=25565
# AMP_BOT_USERNAME=AMP
# AMP_BOT_GAME_MODE=survival
# AMP_MODE=guided
# AMP_OPERATOR_USERNAME=YourMinecraftName
# AMP_JAVA_PATH=C:\Program Files\Java\jdk-25\bin\java.exe
